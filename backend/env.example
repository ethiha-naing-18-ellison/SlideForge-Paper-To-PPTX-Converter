# SlideForge Backend Configuration

# Summarization Backend
SUMMARIZER_BACKEND=textrank  # Options: textrank, hf_transformer

# Hugging Face Transformer Settings (optional)
HF_MODEL_NAME=sshleifer/distilbart-cnn-12-6
HF_CACHE_DIR=./models

# Network and API Settings
ENABLE_NETWORK_METADATA=true
CROSSREF_API_URL=https://api.crossref.org/works/
SEMANTIC_SCHOLAR_API_URL=https://api.semanticscholar.org/v1/paper/

# File Storage
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
TEMP_DIR=./temp

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS Settings
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Security
SECRET_KEY=your-secret-key-here-change-in-production
